# --- Base de donnees -------------------------------------------------------
# Dev  : file:./dev.db          (SQLite, aucun service externe requis)
# Prod : postgresql://user:pass@host:5432/edenia?schema=public
DATABASE_URL="file:./dev.db"

# --- Securite --------------------------------------------------------------
SESSION_SECRET=""            # >= 32 caracteres. Rotation = deconnexion globale.
FIELD_ENCRYPTION_KEY=""      # cle AES-256 en base64 (32 octets) pour les champs sensibles

# --- Couche IA (§48 : fournisseur interchangeable) -------------------------
AI_PROVIDER="rulebased"      # rulebased | anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
AI_MAX_TURNS="12"

# --- Messagerie ------------------------------------------------------------
SMS_PROVIDER="console"       # console | <agregateur>
EMAIL_PROVIDER="console"
SMS_SENDER_ID="EDENIA"

# --- Paiement (§42) --------------------------------------------------------
PAYMENT_PROVIDER="simulated" # simulated | tmoney | flooz | mtn_momo | wave | card
PAYMENT_WEBHOOK_SECRET=""

# --- Stockage --------------------------------------------------------------
STORAGE_PROVIDER="local"     # local | s3
S3_BUCKET=""
S3_REGION=""

# --- Web push (§46) --------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_NAME="EDENIA"
NEXT_PUBLIC_APP_URL="https://edenia.app"
