# --- Base de donnees -------------------------------------------------------
# Dev  : file:./dev.db          (SQLite, aucun service externe requis)
# Prod : postgresql://user:pass@host:5432/edenia?schema=public
DATABASE_URL="file:./dev.db"

# --- Mode des services externes ---------------------------------------------
# development : code OTP fixe (228228), affiche a l'ecran, AUCUN SMS envoye.
#               Hachage, tentatives, expiration et limitation restent actifs.
# production  : code aleatoire envoye par la passerelle SMS configuree.
# Par defaut : development hors production, production sinon.
# L'application REFUSE de demarrer avec AUTH_MODE=development en production.
AUTH_MODE="development"

# --- Securite --------------------------------------------------------------
SESSION_SECRET=""            # >= 32 caracteres. Rotation = deconnexion globale.
FIELD_ENCRYPTION_KEY=""      # cle AES-256 en base64 (32 octets) pour les champs sensibles

# --- Couche IA (§48 : fournisseur interchangeable) -------------------------
AI_PROVIDER="rulebased"      # rulebased | anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
AI_MAX_TURNS="12"

# --- Messagerie ------------------------------------------------------------
SMS_PROVIDER="console"       # console | <agregateur>
EMAIL_PROVIDER="console"
SMS_SENDER_ID="EDENIA"

# --- Marches ouverts --------------------------------------------------------
# "TG" (defaut, pilote) | "TG,BJ,CI" | "AFRIQUE_FR" (toute l'Afrique francophone)
# Ouvrir un marche ne demande AUCUN redeploiement de code.
LAUNCHED_COUNTRIES="TG"

# --- Paiement (§42) ---------------------------------------------------------
PAYMENT_PROVIDER="simulated"   # simulated | geniuspay

# --- GeniusPay --------------------------------------------------------------
# ⚠️  Ces valeurs sont des SECRETS. Ne jamais les commiter, ni les journaliser,
#     ni les renvoyer dans une reponse API. Aucune n'est prefixee NEXT_PUBLIC_ :
#     elles ne peuvent donc pas atteindre le navigateur.
GENIUSPAY_BASE_URL="https://geniuspay.ci/api/v1/merchant"
GENIUSPAY_ENVIRONMENT="sandbox"   # sandbox | live
GENIUSPAY_API_KEY=""              # pk_sandbox_... ou pk_live_...
GENIUSPAY_API_SECRET=""           # sk_sandbox_... ou sk_live_...
GENIUSPAY_WEBHOOK_SECRET=""       # whsec_... (rendu une seule fois a la creation du webhook)
GENIUSPAY_TIMEOUT_MS="20000"

# --- Modele economique (§1 a §5 du sprint final) ---------------------------
# free      : lancement gratuit. Premium masque, son code reste en place.
# donations : identique, alias explicite.
# premium   : abonnements payants actifs.
# Le defaut est "free" : un oubli de configuration ne peut pas facturer
# quelqu'un par accident. Rallumer Premium demande un redemarrage, volontairement.
MONETIZATION_MODE="free"
# Interrupteur global des dons. Le back-office peut fermer les dons, jamais les
# rouvrir contre cette variable.
DONATIONS_ENABLED="true"

# --- Stockage --------------------------------------------------------------
STORAGE_PROVIDER="local"     # local | s3
S3_BUCKET=""
S3_REGION=""

# --- Web push (§46) --------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_NAME="EDENIA"
NEXT_PUBLIC_APP_URL="https://edenia.app"
